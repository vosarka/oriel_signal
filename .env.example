DATABASE_URL=mysql://user:password@host:4000/oriel_dev?ssl={"rejectUnauthorized":true}
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=3000
RUN_MIGRATIONS=false
# One-shot schema sync (creates userStaticProfiles + lattice columns):
# pnpm db:migrate
APP_BASE_URL=http://localhost:3000
# In production set to your exact public origin (no trailing slash):
# APP_BASE_URL=https://yourdomain.com
# You can also set TRUSTED_ORIGINS for additional origins (comma separated):
# TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# LLM
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_REQUEST_TIMEOUT_MS=45000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
GEMMA_API_KEY=
GEMMA_API_URL=
GEMMA_MODEL=gemma-4-31b-it
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_MODEL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
AUTH_EMAIL_FROM=
# For Resend (recommended for production transactional emails like password resets)
# Best practice: Use a subdomain to avoid MX conflicts with your main domain's email.
# Example: noreply@mail.yourdomain.com
# Then verify the subdomain in Resend and add the DNS records for it.
RESEND_API_KEY=
RESEND_FROM=

# Stripe / Signature Letters
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SIGNATURE_GLIMPSE_PRICE_ID=
STRIPE_FOUNDING_SIGNATURE_PRICE_ID=

# PayPal / Tetradic Signature Founder Edition
# Keep sandbox until the complete checkout + webhook flow is verified.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Webhook URL:
# https://yourdomain.com/api/paypal/tetradic-signature/webhook

# S3-compatible storage for final Signature Letter PDFs
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

