DATABASE_URL=mysql://user:password@host:4000/oriel_dev?ssl={"rejectUnauthorized":true}
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=3000
RUN_MIGRATIONS=false
# One-shot schema sync (creates userStaticProfiles + lattice columns):
# pnpm db:migrate
APP_BASE_URL=http://localhost:3000
# In production set to your exact public origin (no trailing slash):
# APP_BASE_URL=https://yourdomain.com
# You can also set TRUSTED_ORIGINS for additional origins (comma separated):
# TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ORIEL self-modification switches. Both OFF unless explicitly enabled.
# ORIEL_AUTONOMY_RUNTIME lets an approved runtime profile overlay the prompt.
# ORIEL_WIKI_EVOLUTION lets ORIEL write wiki pages from a conversation. The wiki
# is read back into the prompt, so leaving this on means an interpretation can
# become canon on the next turn. Identity and origin pages stay protected either way.
ORIEL_AUTONOMY_RUNTIME=false
ORIEL_WIKI_EVOLUTION=false
# Semantic index only. Official memory stays in TiDB. When true, chat retrieves
# 3 memories for this message via MindMemOS search, then hydrates TiDB rows.
ORIEL_MINDMEMOS=false
ORIEL_MINDMEMOS_BASE_URL=
ORIEL_MINDMEMOS_API_KEY=

# LLM
# mistral = Mistral → Groq → Gemini 3.8 (paid last).
# gemma = Groq → Mistral → Gemini.
LLM_PROVIDER=mistral
LLM_MODEL=
LLM_REQUEST_TIMEOUT_MS=45000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
GEMMA_API_KEY=
GEMMA_API_URL=https://api.groq.com/openai/v1/chat/completions
GEMMA_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-large-latest
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_MODEL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
AUTH_EMAIL_FROM=
# For Resend (recommended for production transactional emails like password resets)
# Best practice: Use a subdomain to avoid MX conflicts with your main domain's email.
# Example: noreply@mail.yourdomain.com
# Then verify the subdomain in Resend and add the DNS records for it.
RESEND_API_KEY=
RESEND_FROM=

# Stripe / Signature Letters
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SIGNATURE_GLIMPSE_PRICE_ID=
STRIPE_FOUNDING_SIGNATURE_PRICE_ID=

# PayPal / Tetradic Signature Founder Edition
# Keep sandbox until the complete checkout + webhook flow is verified.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Webhook URL:
# https://yourdomain.com/api/paypal/tetradic-signature/webhook

# S3-compatible storage for final Signature Letter PDFs
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Voice / Realtime
ELEVENLABS_API_KEY=
# Voice chain: Mistral Voxtral first, then ElevenLabs. Inworld is not in it;
# it serves the realtime session only, further down this file.
# Voxtral bills the MISTRAL_API_KEY above, at roughly a sixth of ElevenLabs.
# Leave these unset to use the built-in defaults. A blank value is not the
# same as unset for some services, so prefer removing the line to emptying it.
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
# ORIEL's two voices, cloned in Mistral: sophianic is the one nearly every
# reply uses, deep is the second. Both are built into the code as defaults,
# so these lines only matter when a voice is re-cloned and gets a new id.
MISTRAL_TTS_VOICE_ID=1c568f5a-b040-459c-9c24-aca6eef4149b
MISTRAL_TTS_VOICE_DEEP_ID=4f381381-d79e-468c-9724-63edd0c5883a
# Same for the fallback: without it, a deep reply that falls through to
# ElevenLabs is spoken by that vendor's generic voice.
ELEVENLABS_VOICE_DEEP_ID=
ELEVENLABS_VOICE_ID=cxaldBH0hjovpksFNKxb
ELEVENLABS_VOICE_SOPHIANIC_ID=RILOU7YmBhvwJGDGjNmP
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Realtime voice session only. ORIEL's spoken replies no longer use Inworld;
# that chain is Mistral Voxtral then ElevenLabs.
INWORLD_API_KEY=
INWORLD_REALTIME_MODEL=google-vertex/gemma-4-26b-a4b
INWORLD_REALTIME_STT_MODEL=assemblyai/u3-rt-pro
INWORLD_REALTIME_TTS_MODEL=inworld-tts-2
INWORLD_REALTIME_VOICE_SOPHIANIC=default-0o0vqxaayifb0rqvrpyf5a__oriel_fema
INWORLD_REALTIME_VOICE_DEEP=default-0o0vqxaayifb0rqvrpyf5a__oriel_serii
INWORLD_REALTIME_VAD_EAGERNESS=low
